{
  "backends": {
    "default-s3": {
      "kind": "s3",
      "revision": "v1",
      "bucket": "xarta-archive",
      "prefix": "default",
      "endpoint_url": "http://minio:9000",
      "aws_access_key_id": "xarta-dev",
      "aws_secret_access_key": "xarta-dev-secret",
      "region_name": "us-east-1",
      "use_ssl": false
    },
    "secondary-s3": {
      "kind": "s3",
      "revision": "v1",
      "bucket": "xarta-archive-secondary",
      "prefix": "secondary",
      "endpoint_url": "http://minio:9000",
      "aws_access_key_id": "xarta-dev",
      "aws_secret_access_key": "xarta-dev-secret",
      "region_name": "us-east-1",
      "use_ssl": false
    }
  },
  "archives": {
    "default": {
      "backend": "default-s3",
      "policy": {
        "write": "versioned",
        "history": "retain-all",
        "require_current_predecessor": true,
        "duplicate_unchanged": true
      }
    },
    "secondary": {
      "backend": "secondary-s3",
      "policy": {
        "write": "versioned",
        "history": "retain-metadata",
        "require_current_predecessor": false,
        "duplicate_unchanged": true
      }
    }
  }
}
